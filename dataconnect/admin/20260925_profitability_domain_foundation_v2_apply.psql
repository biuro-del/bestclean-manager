-- DATABASE-ADMIN CANDIDATE ONLY. Never run without separate migration approval.
--
-- This is the only supported executable entrypoint for the profitability
-- domain Foundation V2 migration. The raw SQL file rejects direct execution.
-- The wrapper creates no roles and installs no extensions.
--
-- Required invocation parameters (none is a secret):
--   -v profitability_foundation_expected_database=iclean-room-database
--   -v profitability_foundation_expected_executor=profitability_migration_executor
--   -v profitability_foundation_expected_provisioner=profitability_provisioner
--   -v profitability_foundation_expected_bootstrap_grantor=<exact OID-10 role>
--   -v profitability_foundation_expected_migration_runner=profitability_migration_runner
--   -v profitability_foundation_owner_role=profitability_owner
--   -v profitability_foundation_runtime_role=profitability_runtime
--   -v profitability_foundation_session_role=profitability_session
--   -v profitability_foundation_expected_btree_gist_version=1.7
--   -v profitability_foundation_expected_btree_gist_schema=public
--   -v profitability_foundation_backup_reference=1790402094445
--   -v profitability_foundation_confirmation=APPLY_PROFITABILITY_DOMAIN_FOUNDATION_V2_ONLY_20260926

\set ON_ERROR_STOP on

\if :{?profitability_foundation_expected_database}
\else
  do $$ begin
    raise exception 'PROFITABILITY_FOUNDATION_V2_EXPECTED_DATABASE_REQUIRED';
  end $$;
\endif

\if :{?profitability_foundation_expected_executor}
\else
  do $$ begin
    raise exception 'PROFITABILITY_FOUNDATION_V2_EXPECTED_EXECUTOR_REQUIRED';
  end $$;
\endif

\if :{?profitability_foundation_expected_provisioner}
\else
  do $$ begin
    raise exception 'PROFITABILITY_FOUNDATION_V2_EXPECTED_PROVISIONER_REQUIRED';
  end $$;
\endif

\if :{?profitability_foundation_expected_bootstrap_grantor}
\else
  do $$ begin
    raise exception 'PROFITABILITY_FOUNDATION_V2_EXPECTED_BOOTSTRAP_GRANTOR_REQUIRED';
  end $$;
\endif

\if :{?profitability_foundation_expected_migration_runner}
\else
  do $$ begin
    raise exception 'PROFITABILITY_FOUNDATION_V2_EXPECTED_MIGRATION_RUNNER_REQUIRED';
  end $$;
\endif

\if :{?profitability_foundation_owner_role}
\else
  do $$ begin
    raise exception 'PROFITABILITY_FOUNDATION_V2_OWNER_ROLE_REQUIRED';
  end $$;
\endif

\if :{?profitability_foundation_runtime_role}
\else
  do $$ begin
    raise exception 'PROFITABILITY_FOUNDATION_V2_RUNTIME_ROLE_REQUIRED';
  end $$;
\endif

\if :{?profitability_foundation_session_role}
\else
  do $$ begin
    raise exception 'PROFITABILITY_FOUNDATION_V2_SESSION_ROLE_REQUIRED';
  end $$;
\endif

\if :{?profitability_foundation_expected_btree_gist_version}
\else
  do $$ begin
    raise exception 'PROFITABILITY_FOUNDATION_V2_BTREE_GIST_VERSION_REQUIRED';
  end $$;
\endif

\if :{?profitability_foundation_expected_btree_gist_schema}
\else
  do $$ begin
    raise exception 'PROFITABILITY_FOUNDATION_V2_BTREE_GIST_SCHEMA_REQUIRED';
  end $$;
\endif

\if :{?profitability_foundation_backup_reference}
\else
  do $$ begin
    raise exception 'PROFITABILITY_FOUNDATION_V2_BACKUP_REFERENCE_REQUIRED';
  end $$;
\endif

\if :{?profitability_foundation_confirmation}
\else
  do $$ begin
    raise exception 'PROFITABILITY_FOUNDATION_V2_CONFIRMATION_REQUIRED';
  end $$;
\endif

select
  :'profitability_foundation_expected_database' = 'iclean-room-database'
    as profitability_foundation_approved_database_confirmed,
  current_database() = :'profitability_foundation_expected_database'
    as profitability_foundation_database_confirmed,
  :'profitability_foundation_expected_executor' = 'profitability_migration_executor'
    and session_user = :'profitability_foundation_expected_executor'
    and current_user = session_user
    as profitability_foundation_executor_confirmed,
  :'profitability_foundation_expected_provisioner' = 'profitability_provisioner'
    as profitability_foundation_provisioner_name_confirmed,
  :'profitability_foundation_expected_bootstrap_grantor' = pg_get_userbyid(10)
    as profitability_foundation_bootstrap_grantor_confirmed,
  :'profitability_foundation_expected_migration_runner' = 'profitability_migration_runner'
    as profitability_foundation_runner_name_confirmed,
  :'profitability_foundation_owner_role' = 'profitability_owner'
    as profitability_foundation_owner_name_confirmed,
  :'profitability_foundation_runtime_role' = 'profitability_runtime'
    as profitability_foundation_runtime_name_confirmed,
  :'profitability_foundation_session_role' = 'profitability_session'
    as profitability_foundation_session_name_confirmed,
  :'profitability_foundation_expected_btree_gist_version' = '1.7'
    as profitability_foundation_extension_version_confirmed,
  :'profitability_foundation_expected_btree_gist_schema' = 'public'
    as profitability_foundation_extension_schema_confirmed,
  :'profitability_foundation_backup_reference' = '1790402094445'
    as profitability_foundation_backup_confirmed,
  :'profitability_foundation_confirmation'
    = 'APPLY_PROFITABILITY_DOMAIN_FOUNDATION_V2_ONLY_20260926'
    as profitability_foundation_execution_confirmed,
  current_setting('server_version_num')::integer between 170000 and 179999
    as profitability_foundation_pg17_confirmed,
  not pg_is_in_recovery()
    as profitability_foundation_primary_confirmed,
  current_setting('transaction_read_only') = 'off'
    and current_setting('default_transaction_read_only') = 'off'
    as profitability_foundation_read_write_confirmed
\gset

\if :profitability_foundation_approved_database_confirmed
\else
  do $$ begin
    raise exception 'PROFITABILITY_FOUNDATION_V2_APPROVED_DATABASE_MISMATCH';
  end $$;
\endif

\if :profitability_foundation_database_confirmed
\else
  do $$ begin
    raise exception 'PROFITABILITY_FOUNDATION_V2_DATABASE_MISMATCH';
  end $$;
\endif

\if :profitability_foundation_executor_confirmed
\else
  do $$ begin
    raise exception 'PROFITABILITY_FOUNDATION_V2_EXECUTOR_MISMATCH';
  end $$;
\endif

\if :profitability_foundation_provisioner_name_confirmed
\else
  do $$ begin
    raise exception 'PROFITABILITY_FOUNDATION_V2_PROVISIONER_MISMATCH';
  end $$;
\endif

\if :profitability_foundation_bootstrap_grantor_confirmed
\else
  do $$ begin
    raise exception 'PROFITABILITY_FOUNDATION_V2_BOOTSTRAP_GRANTOR_MISMATCH';
  end $$;
\endif

\if :profitability_foundation_runner_name_confirmed
\else
  do $$ begin
    raise exception 'PROFITABILITY_FOUNDATION_V2_MIGRATION_RUNNER_MISMATCH';
  end $$;
\endif

\if :profitability_foundation_owner_name_confirmed
\else
  do $$ begin
    raise exception 'PROFITABILITY_FOUNDATION_V2_OWNER_ROLE_MISMATCH';
  end $$;
\endif

\if :profitability_foundation_runtime_name_confirmed
\else
  do $$ begin
    raise exception 'PROFITABILITY_FOUNDATION_V2_RUNTIME_ROLE_MISMATCH';
  end $$;
\endif

\if :profitability_foundation_session_name_confirmed
\else
  do $$ begin
    raise exception 'PROFITABILITY_FOUNDATION_V2_SESSION_ROLE_MISMATCH';
  end $$;
\endif

\if :profitability_foundation_extension_version_confirmed
\else
  do $$ begin
    raise exception 'PROFITABILITY_FOUNDATION_V2_APPROVED_BTREE_GIST_VERSION_MISMATCH';
  end $$;
\endif

\if :profitability_foundation_extension_schema_confirmed
\else
  do $$ begin
    raise exception 'PROFITABILITY_FOUNDATION_V2_APPROVED_BTREE_GIST_SCHEMA_MISMATCH';
  end $$;
\endif

\if :profitability_foundation_backup_confirmed
\else
  do $$ begin
    raise exception 'PROFITABILITY_FOUNDATION_V2_APPROVED_BACKUP_MISMATCH';
  end $$;
\endif

\if :profitability_foundation_execution_confirmed
\else
  do $$ begin
    raise exception 'PROFITABILITY_FOUNDATION_V2_CONFIRMATION_MISMATCH';
  end $$;
\endif

\if :profitability_foundation_pg17_confirmed
\else
  do $$ begin
    raise exception 'PROFITABILITY_FOUNDATION_V2_POSTGRESQL_17_REQUIRED';
  end $$;
\endif

\if :profitability_foundation_primary_confirmed
\else
  do $$ begin
    raise exception 'PROFITABILITY_FOUNDATION_V2_PRIMARY_DATABASE_REQUIRED';
  end $$;
\endif

\if :profitability_foundation_read_write_confirmed
\else
  do $$ begin
    raise exception 'PROFITABILITY_FOUNDATION_V2_READ_WRITE_SESSION_REQUIRED';
  end $$;
\endif

-- Verify the complete role graph before entering the transaction. Foundation
-- never creates roles or credentials and never grants access to a broad shared
-- application role.
select
  exists (
    select 1
      from pg_roles role_row
     where role_row.rolname = :'profitability_foundation_expected_executor'
       and role_row.rolcanlogin
       and not role_row.rolinherit
       and not role_row.rolsuper
       and not role_row.rolbypassrls
       and not role_row.rolcreaterole
       and not role_row.rolcreatedb
       and not role_row.rolreplication
  ) as profitability_foundation_executor_role_confirmed,
  exists (
    select 1
      from pg_roles role_row
     where role_row.rolname = :'profitability_foundation_expected_provisioner'
       and role_row.rolcanlogin
       and not role_row.rolinherit
       and not role_row.rolsuper
       and not role_row.rolbypassrls
       and role_row.rolcreaterole
       and not role_row.rolcreatedb
       and not role_row.rolreplication
       and role_row.rolconnlimit = -1
       and role_row.rolvaliduntil is null
       and role_row.rolconfig is null
  ) as profitability_foundation_provisioner_role_confirmed,
  not exists (
    select 1
      from pg_database database_row
     where database_row.datname = current_database()
       and database_row.datdba = (
         select oid from pg_roles
          where rolname = :'profitability_foundation_expected_provisioner'
       )
  )
  and not exists (
    select 1
      from pg_namespace namespace_row
     where namespace_row.nspname = 'public'
       and namespace_row.nspowner = (
         select oid from pg_roles
          where rolname = :'profitability_foundation_expected_provisioner'
       )
  )
  and (
    select count(*)
      from pg_database database_row
      cross join lateral aclexplode(database_row.datacl) privilege_row
     where privilege_row.grantee = (
       select oid from pg_roles
        where rolname = :'profitability_foundation_expected_provisioner'
     )
  ) = 1
  and (
    select count(*)
      from pg_database database_row
      cross join lateral aclexplode(database_row.datacl) privilege_row
     where database_row.datname = current_database()
       and privilege_row.grantee = (
         select oid from pg_roles
          where rolname = :'profitability_foundation_expected_provisioner'
       )
       and privilege_row.privilege_type = 'CONNECT'
       and privilege_row.is_grantable
  ) = 1
  and (
    select count(*)
      from pg_namespace namespace_row
      cross join lateral aclexplode(namespace_row.nspacl) privilege_row
     where privilege_row.grantee = (
       select oid from pg_roles
        where rolname = :'profitability_foundation_expected_provisioner'
     )
  ) = 2
  and (
    select count(*)
      from pg_namespace namespace_row
      cross join lateral aclexplode(namespace_row.nspacl) privilege_row
     where namespace_row.nspname = 'public'
       and privilege_row.grantee = (
         select oid from pg_roles
          where rolname = :'profitability_foundation_expected_provisioner'
       )
       and privilege_row.privilege_type = any(array['CREATE', 'USAGE']::text[])
       and privilege_row.is_grantable
  ) = 2
    as profitability_foundation_provisioner_acl_confirmed,
  exists (
    select 1
      from pg_roles role_row
     where role_row.rolname = :'profitability_foundation_expected_migration_runner'
       and not role_row.rolcanlogin
       and not role_row.rolinherit
       and not role_row.rolsuper
       and not role_row.rolbypassrls
       and not role_row.rolcreaterole
       and not role_row.rolcreatedb
       and not role_row.rolreplication
  ) as profitability_foundation_runner_role_confirmed,
  exists (
    select 1
      from pg_roles role_row
     where role_row.rolname = :'profitability_foundation_owner_role'
       and not role_row.rolcanlogin
       and not role_row.rolinherit
       and not role_row.rolsuper
       and not role_row.rolbypassrls
       and not role_row.rolcreaterole
       and not role_row.rolcreatedb
       and not role_row.rolreplication
       and has_schema_privilege(role_row.oid, 'public', 'USAGE')
       and has_schema_privilege(role_row.oid, 'public', 'CREATE')
  ) as profitability_foundation_owner_role_confirmed,
  exists (
    select 1
      from pg_roles role_row
     where role_row.rolname = :'profitability_foundation_runtime_role'
       and not role_row.rolcanlogin
       and not role_row.rolinherit
       and not role_row.rolsuper
       and not role_row.rolbypassrls
       and not role_row.rolcreaterole
       and not role_row.rolcreatedb
       and not role_row.rolreplication
       and not has_schema_privilege(role_row.oid, 'public', 'CREATE')
  ) as profitability_foundation_runtime_role_confirmed,
  exists (
    select 1
      from pg_roles role_row
     where role_row.rolname = :'profitability_foundation_session_role'
       and role_row.rolcanlogin
       and not role_row.rolinherit
       and not role_row.rolsuper
       and not role_row.rolbypassrls
       and not role_row.rolcreaterole
       and not role_row.rolcreatedb
       and not role_row.rolreplication
       and not has_schema_privilege(role_row.oid, 'public', 'CREATE')
  ) as profitability_foundation_session_role_confirmed,
  exists (
    select 1
      from pg_auth_members membership_row
      join pg_roles granted_role on granted_role.oid = membership_row.roleid
      join pg_roles member_role on member_role.oid = membership_row.member
     where granted_role.rolname = :'profitability_foundation_expected_migration_runner'
       and member_role.rolname = :'profitability_foundation_expected_executor'
       and membership_row.grantor = (
         select oid from pg_roles
          where rolname = :'profitability_foundation_expected_provisioner'
       )
       and membership_row.set_option
       and not membership_row.inherit_option
       and not membership_row.admin_option
  ) as profitability_foundation_executor_edge_confirmed,
  exists (
    select 1
      from pg_auth_members membership_row
      join pg_roles granted_role on granted_role.oid = membership_row.roleid
      join pg_roles member_role on member_role.oid = membership_row.member
     where granted_role.rolname = :'profitability_foundation_owner_role'
       and member_role.rolname = :'profitability_foundation_expected_migration_runner'
       and membership_row.grantor = (
         select oid from pg_roles
          where rolname = :'profitability_foundation_expected_provisioner'
       )
       and membership_row.set_option
       and not membership_row.inherit_option
       and not membership_row.admin_option
  ) as profitability_foundation_owner_edge_confirmed,
  exists (
    select 1
      from pg_auth_members membership_row
      join pg_roles granted_role on granted_role.oid = membership_row.roleid
      join pg_roles member_role on member_role.oid = membership_row.member
     where granted_role.rolname = :'profitability_foundation_runtime_role'
       and member_role.rolname = :'profitability_foundation_session_role'
       and membership_row.grantor = (
         select oid from pg_roles
          where rolname = :'profitability_foundation_expected_provisioner'
       )
       and membership_row.set_option
       and not membership_row.inherit_option
       and not membership_row.admin_option
  ) as profitability_foundation_runtime_edge_confirmed,
  (
    select count(*)
      from pg_auth_members membership_row
      join pg_roles granted_role on granted_role.oid = membership_row.roleid
      join pg_roles member_role on member_role.oid = membership_row.member
     where granted_role.rolname = any(array[
       :'profitability_foundation_expected_provisioner',
       :'profitability_foundation_expected_executor',
       :'profitability_foundation_expected_migration_runner',
       :'profitability_foundation_owner_role',
       :'profitability_foundation_session_role',
       :'profitability_foundation_runtime_role'
     ])
        or member_role.rolname = any(array[
          :'profitability_foundation_expected_provisioner',
          :'profitability_foundation_expected_executor',
          :'profitability_foundation_expected_migration_runner',
          :'profitability_foundation_owner_role',
          :'profitability_foundation_session_role',
          :'profitability_foundation_runtime_role'
        ])
  ) = 8
  and not exists (
    select 1
      from pg_auth_members membership_row
      join pg_roles granted_role on granted_role.oid = membership_row.roleid
      join pg_roles member_role on member_role.oid = membership_row.member
     where member_role.rolname = :'profitability_foundation_session_role'
       and granted_role.rolname <> :'profitability_foundation_runtime_role'
  ) as profitability_foundation_session_membership_closed,
  not exists (
    select 1
      from pg_auth_members membership_row
      join pg_roles member_role on member_role.oid = membership_row.member
     where member_role.rolname = :'profitability_foundation_runtime_role'
  ) as profitability_foundation_runtime_membership_closed,
  (
    select count(*)
      from pg_auth_members membership_row
      join pg_roles granted_role on granted_role.oid = membership_row.roleid
      join pg_roles member_role on member_role.oid = membership_row.member
     where granted_role.rolname = any(array[
       :'profitability_foundation_expected_executor',
       :'profitability_foundation_expected_migration_runner',
       :'profitability_foundation_owner_role',
       :'profitability_foundation_session_role',
       :'profitability_foundation_runtime_role'
     ])
       and member_role.rolname = :'profitability_foundation_expected_provisioner'
       and membership_row.grantor = 10::oid
       and membership_row.admin_option
       and not membership_row.inherit_option
       and not membership_row.set_option
  ) = 5
  and not exists (
    select 1
      from pg_auth_members membership_row
      join pg_roles granted_role on granted_role.oid = membership_row.roleid
      join pg_roles member_role on member_role.oid = membership_row.member
     where (
       granted_role.rolname = :'profitability_foundation_expected_provisioner'
       or member_role.rolname = :'profitability_foundation_expected_provisioner'
     )
       and not (
         granted_role.rolname = any(array[
           :'profitability_foundation_expected_executor',
           :'profitability_foundation_expected_migration_runner',
           :'profitability_foundation_owner_role',
           :'profitability_foundation_session_role',
           :'profitability_foundation_runtime_role'
         ])
         and member_role.rolname = :'profitability_foundation_expected_provisioner'
         and membership_row.grantor = 10::oid
         and membership_row.admin_option
         and not membership_row.inherit_option
         and not membership_row.set_option
       )
  ) as profitability_foundation_provisioner_membership_closed,
  not exists (
    select 1
      from pg_auth_members membership_row
      join pg_roles granted_role on granted_role.oid = membership_row.roleid
      join pg_roles member_role on member_role.oid = membership_row.member
     where (
       granted_role.rolname = any(array[
         :'profitability_foundation_expected_provisioner',
         :'profitability_foundation_expected_executor',
         :'profitability_foundation_expected_migration_runner',
         :'profitability_foundation_owner_role',
         :'profitability_foundation_session_role',
         :'profitability_foundation_runtime_role'
       ])
       or member_role.rolname = any(array[
         :'profitability_foundation_expected_provisioner',
         :'profitability_foundation_expected_executor',
         :'profitability_foundation_expected_migration_runner',
         :'profitability_foundation_owner_role',
         :'profitability_foundation_session_role',
         :'profitability_foundation_runtime_role'
       ])
     )
       and not (
         (
           membership_row.grantor = (
             select oid from pg_roles
              where rolname = :'profitability_foundation_expected_provisioner'
           )
           and membership_row.set_option
           and not membership_row.inherit_option
           and not membership_row.admin_option
           and (
             (
               granted_role.rolname = :'profitability_foundation_expected_migration_runner'
               and member_role.rolname = :'profitability_foundation_expected_executor'
             )
             or (
               granted_role.rolname = :'profitability_foundation_owner_role'
               and member_role.rolname = :'profitability_foundation_expected_migration_runner'
             )
             or (
               granted_role.rolname = :'profitability_foundation_runtime_role'
               and member_role.rolname = :'profitability_foundation_session_role'
             )
           )
         )
         or (
           granted_role.rolname = any(array[
             :'profitability_foundation_expected_executor',
             :'profitability_foundation_expected_migration_runner',
             :'profitability_foundation_owner_role',
             :'profitability_foundation_session_role',
             :'profitability_foundation_runtime_role'
           ])
           and member_role.rolname = :'profitability_foundation_expected_provisioner'
           and membership_row.grantor = 10::oid
           and membership_row.admin_option
           and not membership_row.inherit_option
           and not membership_row.set_option
         )
       )
  ) as profitability_foundation_membership_graph_closed,
  not exists (
    select 1
      from pg_namespace namespace_row
      cross join lateral aclexplode(namespace_row.nspacl) privilege_row
     where namespace_row.nspname = 'public'
       and privilege_row.grantee = any(array[
         (
           select oid from pg_roles
            where rolname = :'profitability_foundation_expected_executor'
         ),
         (
           select oid from pg_roles
            where rolname = :'profitability_foundation_expected_migration_runner'
         ),
         (
           select oid from pg_roles
            where rolname = :'profitability_foundation_session_role'
         )
       ]::oid[])
  )
  and (
    select array_agg(
             privilege_row.privilege_type
             order by privilege_row.privilege_type
           )
      from pg_namespace namespace_row
      cross join lateral aclexplode(namespace_row.nspacl) privilege_row
     where namespace_row.nspname = 'public'
       and privilege_row.grantee = (
         select oid from pg_roles
          where rolname = :'profitability_foundation_owner_role'
       )
       and not privilege_row.is_grantable
  ) = array['CREATE', 'USAGE']::text[]
  and (
    select array_agg(
             privilege_row.privilege_type
             order by privilege_row.privilege_type
           )
      from pg_namespace namespace_row
      cross join lateral aclexplode(namespace_row.nspacl) privilege_row
     where namespace_row.nspname = 'public'
       and privilege_row.grantee = (
         select oid from pg_roles
          where rolname = :'profitability_foundation_runtime_role'
       )
       and not privilege_row.is_grantable
  ) = array['USAGE']::text[]
  and not exists (
    select 1
      from pg_namespace namespace_row
      cross join lateral aclexplode(namespace_row.nspacl) privilege_row
     where namespace_row.nspname = 'public'
       and privilege_row.grantee = any(array[
         (
           select oid from pg_roles
            where rolname = :'profitability_foundation_owner_role'
         ),
         (
           select oid from pg_roles
            where rolname = :'profitability_foundation_runtime_role'
         )
       ]::oid[])
       and privilege_row.is_grantable
  ) as profitability_foundation_schema_acl_confirmed,
  exists (
    select 1
      from pg_extension extension_row
      join pg_namespace namespace_row on namespace_row.oid = extension_row.extnamespace
     where extension_row.extname = 'btree_gist'
       and extension_row.extversion = :'profitability_foundation_expected_btree_gist_version'
       and namespace_row.nspname = :'profitability_foundation_expected_btree_gist_schema'
  ) as profitability_foundation_extension_confirmed
\gset

\if :profitability_foundation_executor_role_confirmed
\else
  do $$ begin
    raise exception 'PROFITABILITY_FOUNDATION_V2_EXECUTOR_ROLE_INVALID';
  end $$;
\endif

\if :profitability_foundation_provisioner_role_confirmed
\else
  do $$ begin
    raise exception 'PROFITABILITY_FOUNDATION_V2_PROVISIONER_ROLE_INVALID';
