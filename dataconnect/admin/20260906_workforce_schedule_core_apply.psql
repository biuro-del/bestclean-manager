-- DATABASE-ADMIN CANDIDATE ONLY. Never run without separate migration approval.
--
-- This is the only approved executable entrypoint for the production Grafik
-- core migration. The raw SQL file is kept separately for deterministic PG17
-- tests and must not be invoked directly by an operator.
--
-- Required invocation parameters (none is a secret):
--   -v workforce_schedule_expected_database=iclean-room-database
--   -v workforce_schedule_expected_migration_runner=migration_runner
--   -v workforce_schedule_core_confirmation=APPLY_WORKFORCE_SCHEDULE_CORE_ONLY_20260906

\set ON_ERROR_STOP on

\if :{?workforce_schedule_expected_database}
\else
  do $$ begin
    raise exception 'WORKFORCE_SCHEDULE_EXPECTED_DATABASE_REQUIRED';
  end $$;
\endif

\if :{?workforce_schedule_expected_migration_runner}
\else
  do $$ begin
    raise exception 'WORKFORCE_SCHEDULE_EXPECTED_MIGRATION_RUNNER_REQUIRED';
  end $$;
\endif

\if :{?workforce_schedule_core_confirmation}
\else
  do $$ begin
    raise exception 'WORKFORCE_SCHEDULE_CORE_CONFIRMATION_REQUIRED';
  end $$;
\endif

select
  :'workforce_schedule_expected_database' = 'iclean-room-database'
    as workforce_schedule_approved_database_confirmed,
  current_database() = :'workforce_schedule_expected_database'
    as workforce_schedule_database_confirmed,
  :'workforce_schedule_expected_migration_runner' = 'migration_runner'
    as workforce_schedule_approved_runner_confirmed,
  session_user = :'workforce_schedule_expected_migration_runner'
    and current_user = session_user
    as workforce_schedule_session_confirmed,
  :'workforce_schedule_core_confirmation'
    = 'APPLY_WORKFORCE_SCHEDULE_CORE_ONLY_20260906'
    as workforce_schedule_execution_confirmed,
  current_setting('server_version_num')::integer between 170000 and 179999
    as workforce_schedule_pg17_confirmed,
  not pg_is_in_recovery()
    as workforce_schedule_primary_confirmed,
  current_setting('transaction_read_only') = 'off'
    and current_setting('default_transaction_read_only') = 'off'
    as workforce_schedule_read_write_confirmed
\gset

\if :workforce_schedule_approved_database_confirmed
\else
  do $$ begin
    raise exception 'WORKFORCE_SCHEDULE_APPROVED_DATABASE_MISMATCH';
  end $$;
\endif

\if :workforce_schedule_database_confirmed
\else
  do $$ begin
    raise exception 'WORKFORCE_SCHEDULE_DATABASE_MISMATCH';
  end $$;
\endif

\if :workforce_schedule_approved_runner_confirmed
\else
  do $$ begin
    raise exception 'WORKFORCE_SCHEDULE_APPROVED_MIGRATION_RUNNER_MISMATCH';
  end $$;
\endif

\if :workforce_schedule_session_confirmed
\else
  do $$ begin
    raise exception 'WORKFORCE_SCHEDULE_MIGRATION_SESSION_MISMATCH';
  end $$;
\endif

\if :workforce_schedule_execution_confirmed
\else
  do $$ begin
    raise exception 'WORKFORCE_SCHEDULE_CORE_CONFIRMATION_MISMATCH';
  end $$;
\endif

\if :workforce_schedule_pg17_confirmed
\else
  do $$ begin
    raise exception 'WORKFORCE_SCHEDULE_POSTGRESQL_17_REQUIRED';
  end $$;
\endif

\if :workforce_schedule_primary_confirmed
\else
  do $$ begin
    raise exception 'WORKFORCE_SCHEDULE_PRIMARY_DATABASE_REQUIRED';
  end $$;
\endif

\if :workforce_schedule_read_write_confirmed
\else
  do $$ begin
    raise exception 'WORKFORCE_SCHEDULE_READ_WRITE_SESSION_REQUIRED';
  end $$;
\endif

-- Arm the raw SQL only after every production-target guard has passed. The raw
-- file consumes this session marker before BEGIN, so a retry must return
-- through this wrapper and repeat all checks.
select set_config(
  'cleanzi.workforce_schedule_core_entrypoint',
  'GUARDED_WORKFORCE_SCHEDULE_CORE_20260906',
  false
);

-- Keep this include after every fail-closed gate above. \ir resolves the path
-- relative to this wrapper, independently of the operator's working directory.
\ir ../migrations/20260906_workforce_schedule_core_additive.sql

select set_config('cleanzi.workforce_schedule_core_entrypoint', '', false);

\echo 'WORKFORCE_SCHEDULE_CORE_MIGRATION_APPLIED'
