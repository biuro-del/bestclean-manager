begin;

set local lock_timeout = '5s';
set local statement_timeout = '120s';
set local idle_in_transaction_session_timeout = '180s';

select pg_advisory_xact_lock(
  hashtextextended('cleanzi:profitability:foundation-v2:roles', 0)
);

select pg_advisory_xact_lock(
  hashtextextended('cleanzi:profitability-access-profile:v2', 0)
);

-- Arm the raw SQL only after every production-target guard has passed. Every
-- retry must return through this wrapper and repeat the complete role graph,
-- target and backup checks.
select set_config(
  'cleanzi.profitability_access_v2_entrypoint',
  'GUARDED_PROFITABILITY_ACCESS_PROFILE_V2_20260925',
  true
);

select set_config(
  'cleanzi.profitability_access_v2_expected_executor',
  :'profitability_access_expected_executor',
  true
);

select set_config(
  'cleanzi.profitability_access_v2_expected_provisioner',
