  true
);

select set_config(
  'cleanzi.profitability_access_v2_backup_reference',
  :'profitability_access_backup_reference',
  true
);

set local role :"profitability_access_expected_migration_runner";

-- Keep this include after every fail-closed gate above. \ir resolves relative
-- to this file and does not depend on the operator's working directory.
\ir ../migrations/20260925_profitability_access_profile_v2_additive.sql

commit;

\echo 'PROFITABILITY_ACCESS_PROFILE_V2_MIGRATION_APPLIED'
