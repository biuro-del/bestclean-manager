# Server-only. Never expose through Vite or browser-delivered configuration.
CLEANZI_REGISTRATION_HMAC_SECRET=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
DATABASE_URL=

# Non-secret server configuration.
CLEANZI_REGISTRATION_ALLOWED_ORIGINS=https://cleanzi.pl,https://www.cleanzi.pl
CLEANZI_REGISTRATION_ALLOWED_HOSTNAMES=cleanzi.pl,www.cleanzi.pl,portal.cleanzi.pl
CLEANZI_REGISTRATION_APP_CHECK_APP_IDS=
CLEANZI_VERIFICATION_CONTINUE_URL=https://portal.cleanzi.pl/rejestracja/potwierdzona
CLEANZI_PASSWORD_OPERATION_COLLECTION=cleanziPasswordRegistrationOperations
CLEANZI_VERIFICATION_FROM=Cleanzi <rejestracja@cleanzi.pl>
CLEANZI_VERIFICATION_REPLY_TO=
CLEANZI_PASSWORD_CHECK_USER_AGENT=Cleanzi-registration-password-policy/1.0
CLEANZI_REGISTRATION_ABUSE_COLLECTION=cleanziRegistrationAbuseCounters
CLEANZI_VERIFICATION_DELIVERY_COLLECTION=cleanziVerificationDeliveries

# DATABASE_URL reuses the existing server-only Cloud SQL connection secret used
# by the Polish registration backend. Never prefix secrets with NEXT_PUBLIC_ or VITE_.
