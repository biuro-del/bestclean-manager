rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function hasOrgAccess(orgId) {
      return signedIn()
        && (
          request.auth.token.org_id == orgId
          || request.auth.token.orgId == orgId
          || request.auth.token.orgs[orgId] == true
          || request.auth.token.role in ['ADMIN', 'MANAGER', 'COORDINATOR']
        );
    }

    function isAllowedMobileClosureUpload(orgId) {
      return signedIn()
        && request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && request.resource.metadata.orgId == orgId
        && request.resource.metadata.createdByUid == request.auth.uid
        && request.resource.metadata.source == 'mobile-web';
    }

    match /orgs/{orgId}/mobile-closures/{scope}/{year}/{month}/{workerLogin}/{keyId}/{fileName} {
      allow create: if isAllowedMobileClosureUpload(orgId);
      allow read: if hasOrgAccess(orgId)
        || (signedIn() && resource.metadata.createdByUid == request.auth.uid);
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
