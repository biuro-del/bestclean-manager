# Firebase Web App config
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_FIREBASE_FUNCTIONS_REGION=your-functions-region
# Prawdziwe maile są domyślnie dozwolone wyłącznie dla projektu iclean-room.
# W testach użyj emulatora. Wyjątek wymaga jawnej wartości firebase-test-explicit.
# VITE_AUTH_EMAIL_DELIVERY_MODE=disabled
# Pełny bazowy URL używany tylko dla operacji niewystawionych przez /api.
# VITE_FIREBASE_FUNCTIONS_BASE_URL=https://your-region-your-project.cloudfunctions.net

# Optional but recommended before public release.
# Enable Firebase App Check enforcement in Firebase console and set the public site key here.
# VITE_FIREBASE_APPCHECK_SITE_KEY=

# Required only when self-service cleaning-company registration is released.
# The central issuer is in europe-west1. Set READY=true only after the issuer,
# Firebase Auth, App Check and portal.cleanzi.pl have passed the release preflight.
VITE_CENTRAL_REGISTRATION_ISSUER_READY=false
# This is the public OAuth client ID configured by the central issuer. Never
# put a Google client secret in a VITE_ variable.
# VITE_CENTRAL_REGISTRATION_GOOGLE_CLIENT_ID=

# Osobna, nazwana aplikacja Firebase Auth wylacznie dla Centrum platformy.
# Te wartosci nie zmieniaja Firebase uzywanego przez zwykle konta organizacji.
VITE_PLATFORM_FIREBASE_API_KEY=your-platform-firebase-web-api-key
VITE_PLATFORM_FIREBASE_AUTH_DOMAIN=your-platform-project.firebaseapp.com
VITE_PLATFORM_FIREBASE_PROJECT_ID=your-platform-project-id
VITE_PLATFORM_FIREBASE_STORAGE_BUCKET=your-platform-project.firebasestorage.app
VITE_PLATFORM_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_PLATFORM_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_PLATFORM_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Google Maps / Places autocomplete in order locations.
# Required for searching live Google Maps addresses and saving placeId/lat/lng for map views.
# VITE_GOOGLE_MAPS_API_KEY=

# Optional: use Data Connect emulator
VITE_DATACONNECT_LOCATION=your-dataconnect-location
VITE_DATACONNECT_SERVICE=your-dataconnect-service-id
VITE_DATACONNECT_CONNECTOR=your-dataconnect-connector-id
# VITE_DATACONNECT_EMULATOR_HOST=localhost
# VITE_DATACONNECT_EMULATOR_PORT=9399

# Opcjonalny, niezależny adres API panelu platformy. Domyślnie używane jest /api.
# VITE_PLATFORM_API_BASE=/api

# Optional: backend endpoint for admin-managed user onboarding.
# If empty, portal uses same-origin /api/admin/users served by the App Hosting server.
# VITE_ADMIN_API_BASE=/api
# Optional in local Vite dev: proxy /api to this backend.
# VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8080
# Opcjonalny jawny proxy target dla wywołań /__functions w trybie developerskim.
# VITE_DEV_FUNCTIONS_PROXY_TARGET=https://your-region-your-project.cloudfunctions.net

# Optional: backend endpoints for worker creation and ID preview.
# Leave empty to use same-origin /api/admin/users and /api/admin/worker-id/next.
# VITE_ADMIN_USERS_ENDPOINT=/api/admin/users
# VITE_WORKER_ID_NEXT_ENDPOINT=/api/admin/worker-id/next

# Optional: backend endpoint for resetting a worker password in Firebase Auth.
# Leave empty to use same-origin /api/admin/worker-password/set.
# VITE_WORKER_PASSWORD_SET_ENDPOINT=/api/admin/worker-password/set

# Optional: backend endpoints for worker profile edit/delete.
# Leave empty to use same-origin /api/admin/worker-profile/update and /api/admin/worker-profile/delete.
# VITE_WORKER_PROFILE_UPDATE_ENDPOINT=/api/admin/worker-profile/update
# VITE_WORKER_PROFILE_DELETE_ENDPOINT=/api/admin/worker-profile/delete
# VITE_WORKER_RESTORE_ENDPOINT=/api/admin/workers/restore
