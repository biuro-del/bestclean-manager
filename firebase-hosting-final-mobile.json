{
  "hosting": {
    "site": "iclean-room",
    "public": "web-app/dist-final-mobile",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/authBootstrapMembership", "function": { "functionId": "authBootstrapMembership", "region": "europe-west3" } },
      { "source": "/api/**", "function": { "functionId": "api", "region": "europe-central2" } },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
