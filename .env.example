NODE_ENV=development
APP_TARGET=both
PORT=8080

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_WEB_API_KEY=your-firebase-web-api-key

API_PROXY_TARGET=https://your-region-your-project.cloudfunctions.net
API_PROXY_FORWARDED_HOST=your-hosting-domain.web.app
API_PROXY_TIMEOUT_MS=15000
MAX_PROXY_BODY_BYTES=1048576
ROLLBACK_TOKEN_SECRET=change-this-in-production
ROLLBACK_TOKEN_MAX_AGE_MS=900000

# Required for Admin-only encrypted worker password reveal/reset.
# Use a long random value and keep it stable; changing it makes old saved passwords unreadable.
WORKER_PASSWORD_SECRET=change-this-worker-password-vault-secret

# auto: use local DB when configured, otherwise proxy /api/admin/users to API_PROXY_TARGET.
# local/direct: require local DB config for /api/admin/users.
ADMIN_USERS_MODE=auto

# auto: use local DB when configured, otherwise proxy /api/portal/tasks to API_PROXY_TARGET.
# local/direct: require local DB config for those portal storage routes.
PORTAL_DB_ROUTES_MODE=auto

CLOUD_SQL_CONNECTION_NAME=project:region:instance
DB_CONNECTION_MODE=tcp
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=app_database
DB_USER=app_user
DB_PASS=change-me
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=5

# Local development only. Do not enable in production.
LOAD_FUNCTIONS_LOCAL_ENV=false
