NODE_ENV=development
APP_TARGET=portal
PORT=8080

# Local backend only. Leave empty in normal use and never configure in App Hosting.
# Temporary `0` is allowed only when a local HTTPS scanner intercepts Cloud SQL
# and the system CA path cannot validate the connector tunnel.
DEV_BACKEND_TLS_REJECT_UNAUTHORIZED=

# Local Vite auth-session proxy only. Keep true by default. A temporary false is
# allowed only on localhost when a trusted HTTPS scanner replaces the portal
# certificate and the scanner CA cannot be installed in Node.
DEV_AUTH_SESSION_PROXY_TLS_REJECT_UNAUTHORIZED=true

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# Osobny projekt Firebase Auth uzywany wylacznie przez Centrum platformy.
# Nie zastepuje FIREBASE_* i nie jest akceptowany przez endpointy tenantowe.
PLATFORM_FIREBASE_PROJECT_ID=your-platform-firebase-project-id
PLATFORM_FIREBASE_WEB_API_KEY=your-platform-firebase-web-api-key
# Opcjonalne osobne poswiadczenia Admin SDK dla projektu platformowego.
# PLATFORM_FIREBASE_SERVICE_ACCOUNT_FILE=C:\path\to\platform-service-account.json
# PLATFORM_FIREBASE_SERVICE_ACCOUNT_JSON=
# PLATFORM_FIREBASE_SERVICE_ACCOUNT_BASE64=

# Data Connect jest konfigurowany niezależnie od Firebase Auth.
FIREBASE_DATACONNECT_LOCATION=your-dataconnect-location
FIREBASE_DATACONNECT_SERVICE=your-dataconnect-service-id
FIREBASE_DATACONNECT_CONNECTOR=your-dataconnect-connector-id

# Optional for local worker profile update/delete and password changes that touch Firebase Auth.
# Prefer GOOGLE_APPLICATION_CREDENTIALS when you have a local service account JSON file.
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\firebase-service-account.json
# You can also use FIREBASE_SERVICE_ACCOUNT_FILE or FIREBASE_SERVICE_ACCOUNT_PATH.
# FIREBASE_SERVICE_ACCOUNT_FILE=C:\path\to\firebase-service-account.json
# If you place the file as ./serviceAccountKey.json next to index.js, it is loaded automatically.
# Alternative: paste the whole service account JSON into FIREBASE_SERVICE_ACCOUNT_JSON
# or base64-encode it into FIREBASE_SERVICE_ACCOUNT_BASE64.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_BASE64=
# Local fallback: use the currently signed-in gcloud user for Firebase Admin calls.
# FIREBASE_ADMIN_AUTH_CLIENT=gcloud
# Local development only: allow Firebase Auth REST signUp fallback if Admin SDK is unavailable.
# Production should use Firebase Admin SDK and leave this disabled.
# FIREBASE_AUTH_REST_FALLBACK=false

API_PROXY_TARGET=https://your-region-your-project.cloudfunctions.net
API_PROXY_FORWARDED_HOST=your-hosting-domain.web.app
API_PROXY_TIMEOUT_MS=15000
MAX_PROXY_BODY_BYTES=1048576
ROLLBACK_TOKEN_SECRET=change-this-in-production
ROLLBACK_TOKEN_MAX_AGE_MS=900000

# CRUD pracownikow wymaga bezposredniej konfiguracji Cloud SQL.
ADMIN_USERS_MODE=direct

# Portal storage routes use Cloud SQL directly in local development and production.
PORTAL_DB_ROUTES_MODE=direct
# Schedule orders are real calendar orders. Do not store them in localhost file fallback.
PORTAL_SCHEDULE_ORDERS_MODE=direct
PORTAL_TASKS_MODE=direct
# Explicit emergency-only opt-in for file fixtures; keep unset in normal work.
# ALLOW_LOCAL_PORTAL_SCHEDULE_ORDERS_FILE_STORAGE=1
# ALLOW_LOCAL_PORTAL_TASK_FILE_STORAGE=1

# Profil pracownika zapisuje dane bezposrednio w Cloud SQL i Firebase Auth.
WORKER_PROFILE_MODE=direct
# Optional local workaround for antivirus/proxy TLS interception on Cloud SQL.
WORKER_PROFILE_STORAGE_MODE=database

# CLEAN remains disabled unless this flag is explicitly enabled.
# During a canary rollout, list allowed worker IDs or logins, separated by commas.
MOBILE_SERVICE_EXECUTION_CORRELATION_ENABLED=false
MOBILE_SERVICE_EXECUTION_CORRELATION_CANARY_WORKER_IDS=

CLOUD_SQL_CONNECTION_NAME=project:region:instance
DB_CONNECTION_MODE=tcp
# For local Cloud SQL connector auth use adc, gcloud, or leave empty for runtime defaults.
# CLOUD_SQL_AUTH_CLIENT=gcloud
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=app_database
DB_USER=app_user
DB_PASS=change-me
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=5

# Panel rozliczeń działa obecnie wyłącznie w trybie ręcznym. Ustawienie innej
# wartości zostanie odrzucone do czasu zainstalowania implementacji adaptera.
BILLING_PROVIDER=NONE
GUS_BIR1_API_KEY=
# GUS_BIR1_ENDPOINT=https://wyszukiwarkaregon.stat.gov.pl/wsBIR/UslugaBIRzewnPubl.svc
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GO_PLUS=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
# BILLING_PROVIDER_API_BASE=
# BILLING_PROVIDER_PUBLIC_KEY=
# Sekrety operatora przechowuj w Secret Manager, nie w repozytorium.
# BILLING_PROVIDER_SECRET=
# BILLING_PROVIDER_WEBHOOK_SECRET=

# PLATFORM_OWNER: aplikacyjny drugi składnik przez jednorazowy kod email.
# Secret must be random and at least 32 characters; keep it in Secret Manager in production.
PLATFORM_EMAIL_MFA_SECRET=replace-with-at-least-32-random-characters
# custom = tymczasowo pozwala wpisać dowolny adres; firebase = wymusza email konta Firebase.
PLATFORM_EMAIL_MFA_RECIPIENT_MODE=custom
# W trybie custom backend wyśle kod wyłącznie na jeden z tych wcześniej zatwierdzonych adresów.
PLATFORM_EMAIL_MFA_ALLOWED_RECIPIENTS=owner-backup@example.com
PLATFORM_MFA_SMTP_HOST=smtp.example.com
PLATFORM_MFA_SMTP_PORT=587
PLATFORM_MFA_SMTP_SECURE=false
PLATFORM_MFA_SMTP_USER=mailer@example.com
PLATFORM_MFA_SMTP_PASS=change-me
PLATFORM_MFA_EMAIL_FROM=Cleanzi <mailer@example.com>

# Local development only. Do not enable in production.
LOAD_FUNCTIONS_LOCAL_ENV=false

# Fail-closed gate for writing CLEAN correlation snapshots.
# Enable only after the additive database migration, connector deployment and
# a controlled end-to-end scan have all been verified.
MOBILE_SERVICE_EXECUTION_CORRELATION_ENABLED=false
