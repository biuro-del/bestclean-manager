# Ten plik dokumentuje wyłącznie konfigurację modułu Cleanzi-admin.
# Skopiuj właściwe wartości do głównego .env.local oraz web-app/.env.local.

# Frontend -> backend platformy
VITE_PLATFORM_API_BASE=/api

# Firebase Auth (frontend) — osobna nazwana aplikacja tylko dla panelu platformy
VITE_PLATFORM_FIREBASE_API_KEY=your-platform-firebase-web-api-key
VITE_PLATFORM_FIREBASE_AUTH_DOMAIN=your-platform-project.firebaseapp.com
VITE_PLATFORM_FIREBASE_PROJECT_ID=your-platform-project-id
VITE_PLATFORM_FIREBASE_STORAGE_BUCKET=your-platform-project.firebasestorage.app
VITE_PLATFORM_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_PLATFORM_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_PLATFORM_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Admin (backend; niezależny od tenantowego FIREBASE_*)
PLATFORM_FIREBASE_PROJECT_ID=your-platform-project-id
PLATFORM_FIREBASE_WEB_API_KEY=your-platform-firebase-web-api-key
# PLATFORM_FIREBASE_SERVICE_ACCOUNT_FILE=C:\path\to\platform-service-account.json

# Data Connect (niezależne od ustawień Auth)
FIREBASE_DATACONNECT_LOCATION=your-dataconnect-location
FIREBASE_DATACONNECT_SERVICE=your-dataconnect-service-id
FIREBASE_DATACONNECT_CONNECTOR=your-dataconnect-connector-id
VITE_DATACONNECT_LOCATION=your-dataconnect-location
VITE_DATACONNECT_SERVICE=your-dataconnect-service-id
VITE_DATACONNECT_CONNECTOR=your-dataconnect-connector-id

# Cloud SQL / PostgreSQL (wybierz DATABASE_URL albo pola DB_*)
# DATABASE_URL=postgresql://user:password@localhost:5432/database
CLOUD_SQL_CONNECTION_NAME=project:region:instance
DB_CONNECTION_MODE=tcp
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=app_database
DB_USER=app_user
DB_PASS=change-me
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Przyszły operator płatności. NONE i MANUAL nie wykonują zewnętrznych operacji.
BILLING_PROVIDER=NONE
GUS_BIR1_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GO_PLUS=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
# BILLING_PROVIDER_API_BASE=
# BILLING_PROVIDER_PUBLIC_KEY=
# BILLING_PROVIDER_SECRET=
# BILLING_PROVIDER_WEBHOOK_SECRET=

# Prywatne MFA platformy
PLATFORM_EMAIL_MFA_SECRET=replace-with-at-least-32-random-characters
PLATFORM_MFA_SMTP_HOST=smtp.example.com
PLATFORM_MFA_SMTP_PORT=587
PLATFORM_MFA_SMTP_SECURE=false
PLATFORM_MFA_SMTP_USER=mailer@example.com
PLATFORM_MFA_SMTP_PASS=change-me
PLATFORM_MFA_EMAIL_FROM=Cleanzi <mailer@example.com>
